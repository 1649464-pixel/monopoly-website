const socket = io();

const lobbyScreen = document.getElementById('lobbyScreen');
const gameScreen = document.getElementById('gameScreen');
const playersPanel = document.getElementById('playersPanel');
const boardEl = document.getElementById('board');
const playersEl = document.getElementById('players');
const turnLabelEl = document.getElementById('turnLabel');
const logEl = document.getElementById('log');
const createRoomBtn = document.getElementById('createRoomBtn');
const joinRoomBtn = document.getElementById('joinRoomBtn');
const roomCodeInput = document.getElementById('roomCodeInput');
const playerNameInput = document.getElementById('playerName');
const startGameBtn = document.getElementById('startGameBtn');
const rollBtn = document.getElementById('rollBtn');
const buyBtn = document.getElementById('buyBtn');
const roomBadge = document.getElementById('roomBadge');
const leaveRoomBtn = document.getElementById('leaveRoomBtn');
const roomListEl = document.getElementById('roomList');
const die1El = document.getElementById('die1');
const die2El = document.getElementById('die2');

const state = {
  room: null,
  mySocketId: null,
  roomCode: null,
  roomList: []
};

function formatRoomCode(code) {
  return String(code || '').toUpperCase();
}

const TILE_COLORS = {
  brown: '#8b5e3c',
  lightblue: '#7dd3fc',
  pink: '#f9a8d4',
  orange: '#fb923c'
};

function getMyPlayer() {
  if (!state.room) return null;
  return state.room.players.find((player) => player.socketId === state.mySocketId) || null;
}

function isHost() {
  return Boolean(state.room && state.room.hostSocketId === state.mySocketId);
}

function safeRoomCode() {
  return state.room ? state.room.code : state.roomCode || '';
}

function renderRoomList() {
  roomListEl.innerHTML = '';

  if (!state.roomList.length) {
    const item = document.createElement('li');
    item.textContent = 'No rooms available right now.';
    roomListEl.appendChild(item);
    return;
  }

  state.roomList.forEach((room) => {
    const item = document.createElement('li');
    const left = document.createElement('div');
    left.textContent = room.code;
    const meta = document.createElement('div');
    meta.className = 'room-meta';
    meta.textContent = `${room.players} player${room.players === 1 ? '' : 's'} • ${room.started ? 'In progress' : 'Waiting'}`;
    item.appendChild(left);
    item.appendChild(meta);
    roomListEl.appendChild(item);
  });
}

function renderBoard() {
  boardEl.innerHTML = '';
  if (!state.room) {
    return;
  }

  state.room.board.forEach((tile) => {
    const tileEl = document.createElement('div');
    tileEl.className = `tile ${tile.type} ${tile.id === state.room.buyOption?.id ? 'highlight' : ''}`;

    if (tile.type === 'property' || tile.type === 'utility') {
      const color = TILE_COLORS[tile.color] || '#a78bfa';
      tileEl.style.background = `linear-gradient(180deg, rgba(255,255,255,0.08), rgba(0,0,0,0.12)), radial-gradient(circle at top, ${color}bb, transparent 36%), rgba(255,255,255,0.04)`;
    }

    const top = document.createElement('div');
    top.className = 'tile-top';
    const badge = document.createElement('span');
    badge.className = 'badge';
    badge.textContent = tile.type === 'property' ? (tile.color || 'Property') : tile.type;
    top.appendChild(badge);

    const players = document.createElement('div');
    players.className = 'players';
    state.room.players.forEach((player) => {
      if (player.position === tile.id && !player.bankrupt) {
        const token = document.createElement('span');
        token.className = 'token';
        token.textContent = player.name.slice(-1);
        token.style.background = player.color;
        players.appendChild(token);
      }
    });

    const name = document.createElement('div');
    name.className = 'name';
    name.textContent = tile.name;

    const meta = document.createElement('div');
    meta.className = 'meta';
    const value = document.createElement('span');
    if (tile.type === 'property' || tile.type === 'utility') {
      value.textContent = `$${tile.price}`;
    } else if (tile.type === 'tax') {
      value.textContent = `$${tile.amount}`;
    } else if (tile.type === 'start') {
      value.textContent = '+$200';
    } else {
      value.textContent = tile.type === 'chance' ? 'Card' : 'Spot';
    }

    const owner = document.createElement('span');
    owner.textContent = tile.owner || (tile.type === 'property' || tile.type === 'utility' ? 'For Sale' : '');

    meta.append(value, owner);
    tileEl.append(top, name, meta, players);
    boardEl.appendChild(tileEl);
  });
}

function renderPlayers() {
  playersEl.innerHTML = '';
  if (!state.room) return;

  state.room.players.forEach((player) => {
    const card = document.createElement('div');
    card.className = `player-card ${state.room.currentPlayerId === player.socketId ? 'active' : ''}`;

    const head = document.createElement('div');
    head.className = 'player-head';

    const title = document.createElement('div');
    title.className = 'player-title';
    const dot = document.createElement('span');
    dot.className = 'token';
    dot.textContent = player.name.slice(-1);
    dot.style.background = player.color;
    const name = document.createElement('span');
    name.textContent = player.name;
    title.append(dot, name);

    const money = document.createElement('div');
    money.className = 'player-money';
    money.textContent = `$${player.money}`;

    head.append(title, money);

    const list = document.createElement('div');
    list.className = 'player-properties';
    if (!player.owned.length) {
      const none = document.createElement('span');
      none.className = 'property-chip';
      none.textContent = 'No properties';
      list.appendChild(none);
    } else {
      player.owned.forEach((propertyName) => {
        const chip = document.createElement('span');
        chip.className = 'property-chip';
        chip.textContent = propertyName;
        list.appendChild(chip);
      });
    }

    card.append(head, list);
    playersEl.appendChild(card);
  });
}

function renderLog() {
  logEl.innerHTML = '';
  if (!state.room) return;

  state.room.log.forEach((entry) => {
    const line = document.createElement('div');
    line.className = 'log-entry';
    line.textContent = entry;
    logEl.appendChild(line);
  });
}

function renderGame() {
  if (!state.room) {
    lobbyScreen.classList.remove('hidden');
    gameScreen.classList.add('hidden');
    playersPanel.classList.add('hidden');
    return;
  }

  lobbyScreen.classList.add('hidden');
  gameScreen.classList.remove('hidden');
  playersPanel.classList.remove('hidden');

  const currentPlayer = state.room.players.find((player) => player.socketId === state.room.currentPlayerId);
  turnLabelEl.textContent = currentPlayer ? `${currentPlayer.name}'s turn` : 'Waiting...';

  roomBadge.textContent = `Room: ${formatRoomCode(state.room.code)}`;
  roomBadge.classList.remove('hidden');

  startGameBtn.classList.toggle('hidden', !isHost() || state.room.started);
  rollBtn.classList.toggle('hidden', !state.room.started || state.room.currentPlayerId !== state.mySocketId || state.room.waitingForBuy || Boolean(state.room.winner));
  buyBtn.classList.toggle('hidden', !state.room.waitingForBuy || state.room.currentPlayerId !== state.mySocketId || Boolean(state.room.winner));

  if (state.room.waitingForBuy && state.room.buyOption) {
    buyBtn.textContent = `Buy ${state.room.buyOption.name} for $${state.room.buyOption.price}`;
  }

  if (state.room.lastRoll[0] !== null && state.room.lastRoll[1] !== null) {
    die1El.textContent = state.room.lastRoll[0];
    die2El.textContent = state.room.lastRoll[1];
  } else {
    die1El.textContent = '-';
    die2El.textContent = '-';
  }

  leaveRoomBtn.classList.remove('hidden');
  renderBoard();
  renderPlayers();
  renderLog();
}

function resetApp() {
  state.room = null;
  state.roomCode = null;
  roomBadge.classList.add('hidden');
  leaveRoomBtn.classList.add('hidden');
  renderGame();
}

createRoomBtn.addEventListener('click', () => {
  const name = String(playerNameInput.value || 'Player').trim() || 'Player';
  socket.emit('create-room', { name });
});

joinRoomBtn.addEventListener('click', () => {
  const code = formatRoomCode(roomCodeInput.value);
  const name = String(playerNameInput.value || 'Player').trim() || 'Player';
  if (!code) {
    alert('Please enter a room code.');
    return;
  }
  socket.emit('join-room', { roomCode: code, name });
});

startGameBtn.addEventListener('click', () => {
  const roomCode = safeRoomCode();
  if (!roomCode) return;
  socket.emit('start-game', { roomCode });
});

rollBtn.addEventListener('click', () => {
  const roomCode = safeRoomCode();
  if (!roomCode) return;
  socket.emit('roll-dice', { roomCode });
});

buyBtn.addEventListener('click', () => {
  const roomCode = safeRoomCode();
  if (!roomCode) return;
  socket.emit('buy-property', { roomCode });
});

leaveRoomBtn.addEventListener('click', () => {
  resetApp();
});

socket.on('connect', () => {
  state.mySocketId = socket.id;
  renderGame();
});

socket.on('welcome', (payload) => {
  console.log(payload.message);
});

socket.on('room-created', ({ roomCode }) => {
  state.roomCode = formatRoomCode(roomCode);
  roomCodeInput.value = state.roomCode;
});

socket.on('room-state', (room) => {
  state.room = room;
  state.roomCode = formatRoomCode(room.code);
  roomCodeInput.value = state.roomCode;
  renderGame();
});

socket.on('server-message', ({ text, type }) => {
  const message = document.createElement('div');
  message.className = 'log-entry';
  message.textContent = text;
  logEl.prepend(message);

  if (type === 'error') {
    console.warn(text);
  }
});

socket.on('room-list', (rooms) => {
  state.roomList = rooms;
  renderRoomList();
});

renderRoomList();
renderGame();
